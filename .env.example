# Copy to `.env` and fill in. Everything here is inlined into the front-end
# bundle at build time, so nothing secret belongs in this file.

# Optional. The contact form posts to /api/contact on its own origin by default,
# which is the deployed function. Set this only to point the form somewhere else.
VITE_CONTACT_ENDPOINT=

# The endpoint's own settings (RESEND_API_KEY, CONTACT_TO_EMAIL and friends) are
# not read from here — they live in the Vercel project's environment variables.
# See `api/contact.ts`.
